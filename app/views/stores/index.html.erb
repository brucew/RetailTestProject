<h1>Stores</h1>

<table>
  <thead>
    <tr>
      <th>Address</th>
      <th>Inventory Checks</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @stores.each do |store| %>
      <tr>
        <td><%= store.address %></td>
        <td><%= store.inventory_checks.size %></td>
        <td><%= link_to "View", store_path(store) %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<nav>
  <%= link_to "Products", products_path %> |
  <%= link_to "Brands", brands_path %>
</nav>

