<h1>Stores</h1>

<div class="table-scroll">
  <table class="data-table stores">
    <thead>
      <tr>
        <th>Address</th>
        <th class="numeric">Inventory checks</th>
      </tr>
    </thead>
    <tbody>
      <%= render partial: "stores/store", collection: @stores, locals: { check_counts: @check_counts } %>
    </tbody>
  </table>
</div>
