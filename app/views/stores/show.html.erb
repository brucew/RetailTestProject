<h1>Store</h1>

<p>
  <strong>Address:</strong>
  <%= @store.address %>
</p>

<p>
  <strong>Total Inventory Checks:</strong>
  <%= @store.inventory_checks.size %>
</p>

<h2>Inventory Checks</h2>
<table>
  <thead>
    <tr>
      <th>Date</th>
      <th>Inventory</th>
      <th>Product</th>
      <th>Brand</th>
    </tr>
  </thead>
  <tbody>
    <% @store.inventory_checks.each do |event| %>
      <tr>
        <td><%= check_date_tag(event) %></td>
        <td><%= inventory_status_tag(event) %></td>
        <td><%= link_to event.product.name, product_path(event.product) %></td>
        <td><%= event.product.brand&.name %></td>
      </tr>
    <% end %>
  </tbody>
</table>
