<h1><%= @store.address %></h1>

<dl class="summary">
  <dt>Inventory checks</dt>
  <dd><%= number_with_delimiter(@pagy.count) %></dd>
</dl>

<h2>Inventory checks, newest first</h2>

<% if @pagy.count.zero? %>
  <p class="empty-state">No inventory checks have been recorded at this store.</p>
<% else %>
  <div class="table-scroll">
    <table class="data-table inventory-checks">
      <thead>
        <tr>
          <th>Date</th>
          <th>Inventory</th>
          <th>Product</th>
          <th>Brand</th>
        </tr>
      </thead>
      <tbody>
        <%= render partial: "stores/inventory_check", collection: @inventory_checks %>
      </tbody>
    </table>
  </div>

  <%= render "shared/pagination", pagy: @pagy %>
<% end %>
