<h1>Products</h1>

<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Brand</th>
      <th>Inventory Checks</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @products.each do |product| %>
      <tr>
        <td><%= product.name %></td>
        <td><%= product.brand&.name %></td>
        <td><%= product.inventory_checks.size %></td>
        <td><%= link_to "View", product_path(product) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
