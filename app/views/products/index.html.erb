<h1>Products</h1>

<div class="table-scroll">
  <table class="data-table products">
    <thead>
      <tr>
        <th>Name</th>
        <th>Brand</th>
        <th class="numeric">Inventory checks</th>
      </tr>
    </thead>
    <tbody>
      <%= render partial: "products/product", collection: @products, locals: { check_counts: @check_counts } %>
    </tbody>
  </table>
</div>
