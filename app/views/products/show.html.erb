<h1><%= @product.name %></h1>

<p>
  <strong>Brand:</strong>
  <% if @product.brand %>
    <%= link_to @product.brand.name, brand_path(@product.brand) %>
  <% else %>
    None
  <% end %>
</p>

<p>
  <strong>Total Inventory Checks:</strong>
  <%= @product.inventory_checks.size %>
</p>

<h2>Inventory Checks</h2>
<table>
  <thead>
    <tr>
      <th>Date</th>
      <th>Inventory</th>
      <th>Store Address</th>
    </tr>
  </thead>
  <tbody>
    <% @product.inventory_checks.each do |event| %>
      <tr>
        <td><%= check_date_tag(event) %></td>
        <td><%= inventory_status_tag(event) %></td>
        <td><%= event.store&.address %></td>
      </tr>
    <% end %>
  </tbody>
</table>
