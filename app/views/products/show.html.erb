<h1><%= @product.name %></h1>

<dl class="summary">
  <dt>Brand</dt>
  <dd><%= link_to @product.brand.name, @product.brand %></dd>
  <dt>Inventory checks</dt>
  <dd><%= number_with_delimiter(@pagy.count) %></dd>
</dl>

<%= render "products/current_prices", current_prices: @current_prices %>

<h2 id="inventory-checks">Inventory checks, newest first</h2>

<% if @pagy.count.zero? %>
  <p class="empty-state">No inventory checks have been recorded for this product.</p>
<% else %>
  <div class="table-scroll">
    <table class="data-table inventory-checks">
      <thead>
        <tr>
          <th>Date</th>
          <th>Inventory</th>
          <th>Store</th>
        </tr>
      </thead>
      <tbody>
        <%= render partial: "products/inventory_check", collection: @inventory_checks %>
      </tbody>
    </table>
  </div>

  <%= render "shared/pagination", pagy: @pagy, anchor: "inventory-checks" %>
<% end %>
