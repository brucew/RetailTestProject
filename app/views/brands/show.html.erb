<h1><%= @brand.name %></h1>

<dl class="summary">
  <dt>Products</dt>
  <dd><%= number_with_delimiter(@products.size) %></dd>
  <dt>Open alerts</dt>
  <dd><%= open_alerts_link(@brand, @open_alert_count) %></dd>
</dl>

<h2>Products</h2>

<% if @products.empty? %>
  <p class="empty-state">This brand has no products yet.</p>
<% else %>
  <div class="table-scroll">
    <table class="data-table products">
      <thead>
        <tr>
          <th>Name</th>
          <th class="numeric">Inventory checks</th>
        </tr>
      </thead>
      <tbody>
        <%= render partial: "brands/product", collection: @products, as: :product, locals: { check_counts: @check_counts } %>
      </tbody>
    </table>
  </div>
<% end %>
