<h1>Brands</h1>

<div class="table-scroll">
  <table class="data-table brands">
    <thead>
      <tr>
        <th>Name</th>
        <th class="numeric">Products</th>
      </tr>
    </thead>
    <tbody>
      <%= render partial: "brands/brand", collection: @brands, locals: { product_counts: @product_counts } %>
    </tbody>
  </table>
</div>
